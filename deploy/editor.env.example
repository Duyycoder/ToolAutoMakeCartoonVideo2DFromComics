# Copy to /home/dev/game-editor/.env and set a long random password before starting.
EDITOR_PUBLIC_USER=game
EDITOR_PUBLIC_PASSWORD=change-this-before-use
EDITOR_ENABLE_AI=0
# Bật từng phần AI: all | off | danh sách cách nhau bằng dấu phẩy (translate = dịch, phu-de = Whisper).
# Server Linux không có AIVoice → phu-de chạy faster-whisper trên CPU: .venv/bin/pip install faster-whisper
# EDITOR_AI_MODE=translate,phu-de
